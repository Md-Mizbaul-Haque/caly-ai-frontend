{
  "expo": {
    "name": "Caly AI",
    "slug": "caly-ai-frontend",
    "scheme": "calyai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/caly-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/caly-logo.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mizba.calyaifrontend"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/caly-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Caly AI to access your camera to scan your meals"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Caly AI to access your photos to log meals",
          "cameraPermission": "Allow Caly AI to access your camera to scan your meals"
        }
      ],
      "expo-secure-store",
      ["expo-router", { "root": "./src/app" }]
    ]
  }
}
