{
  "expo": {
    "name": "Caly AI",
    "slug": "caly-ai-frontend",
    "scheme": "calyai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/caly-logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mizba.calyaifrontend",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/caly-logo.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mizba.calyaifrontend",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/caly-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Caly AI to access your camera to scan your meals"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Caly AI to access your photos to log meals",
          "cameraPermission": "Allow Caly AI to access your camera to scan your meals"
        }
      ],
      "expo-secure-store",
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "1fa709d1-fcee-4cd9-8c42-c77a05375180"
      }
    },
    "owner": "mizba"
  }
}
